[ext_resource type="Script" uid="uid://cebsxcu8pyeiv" path="res://scripts/fx/jump_burst.gd" id="1"]

[sub_resource type="StandardMaterial3D" id="MatPuff"]
; Unshaded so the puff reads the same whatever the lighting is doing, and
; vertex-coloured so CPUParticles3D's `color` property actually tints it —
; without VERTEX_COLOR_USE_AS_ALBEDO the particles come out plain white and the
; colour tell, which is the whole point of this effect, silently does nothing.
shading_mode = 0
vertex_color_use_as_albedo = true
transparency = 1
blend_mode = 0
cull_mode = 2

[sub_resource type="QuadMesh" id="MeshPuff"]
material = SubResource("MatPuff")
size = Vector2(0.22, 0.22)

[sub_resource type="Curve" id="CurveFade"]
