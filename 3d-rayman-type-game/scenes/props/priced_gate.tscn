[gd_scene format=3 uid="uid://cyksqosrqlu4a"]

[ext_resource type="Script" uid="uid://qyedo6rsexr3" path="res://scripts/props/priced_gate.gd" id="1"]

[sub_resource type="BoxShape3D" id="Shape_panel"]
size = Vector3(8, 8, 0.6)

[sub_resource type="StandardMaterial3D" id="Mat_panel"]
; `emission_enabled` is set HERE rather than in code, because the script tints a
; DUPLICATE of this material and emission is a feature flag — part of what Godot
; keys a shader on. Switch it on in code instead and the duplicate needs its own
; shader compiled. See shockwave.gd.
albedo_color = Color(0.68, 0.33, 0.33, 1)
emission_enabled = true
emission = Color(0.68, 0.33, 0.33, 1)
emission_energy_multiplier = 0.3

[sub_resource type="BoxMesh" id="Mesh_panel"]
material = SubResource("Mat_panel")
size = Vector3(8, 8, 0.6)

; Shape and Visual are both lifted by half the panel height, so the node can be
; dropped at ground level (y = 0) and the gate stands on the floor.
[node name="PricedGate" type="StaticBody3D" collision_layer=1]
script = ExtResource("1")

[node name="Shape" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4, 0)
shape = SubResource("Shape_panel")

[node name="Visual" type="Node3D" parent="."]

[node name="Panel" type="MeshInstance3D" parent="Visual"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4, 0)
mesh = SubResource("Mesh_panel")
