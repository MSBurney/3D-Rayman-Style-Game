[gd_scene format=3 uid="uid://byff07mqdy2xa"]

[ext_resource type="Script" uid="uid://w3lf5q1egekc" path="res://scripts/props/moving_platform.gd" id="1"]

[sub_resource type="BoxShape3D" id="Shape_deck"]
size = Vector3(10, 0.6, 10)

[sub_resource type="StandardMaterial3D" id="Mat_deck"]
albedo_color = Color(0.46, 0.72, 0.78, 1)
emission_enabled = true
emission = Color(0.3, 0.6, 0.7, 1)
emission_energy_multiplier = 0.35

[sub_resource type="BoxMesh" id="Mesh_deck"]
material = SubResource("Mat_deck")
size = Vector3(10, 0.6, 10)

; `sync_to_physics` is the whole reason this is an AnimatableBody3D. With it on,
; Godot measures how far the platform moved this tick and hands that motion to
; whatever is standing on it. Switch it off, or use a plain StaticBody3D, and a
; CharacterBody3D riding this gets left behind — the platform slides out from
; under the player, who looks like they are skating on the spot.
[node name="MovingPlatform" type="AnimatableBody3D"]
collision_layer = 1
; `sync_to_physics` is deliberately OFF, and its own documentation says why:
; "do not use together with _physics_process()". This platform IS moved from
; _physics_process, and with sync on the collision shape lags behind the node —
; the platform draws in one place and collides in another, so the player falls
; straight through a platform they are standing on. moving_platform.gd sets
; `constant_linear_velocity` instead, which is what actually carries a rider.
;
; It must be set EXPLICITLY false: AnimatableBody3D defaults it to true, so
; simply not mentioning it leaves the bug in place.
sync_to_physics = false
script = ExtResource("1")

[node name="Shape" type="CollisionShape3D" parent="."]
shape = SubResource("Shape_deck")

[node name="Visual" type="Node3D" parent="."]

[node name="Mesh" type="MeshInstance3D" parent="Visual"]
mesh = SubResource("Mesh_deck")
