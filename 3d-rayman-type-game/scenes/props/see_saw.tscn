[sub_resource type="StandardMaterial3D" id="Mat_south"]
albedo_color = Color(0.34, 0.66, 0.95, 1)
emission_enabled = true
emission = Color(0.12, 0.3, 0.52, 1)
emission_energy_multiplier = 0.3

[sub_resource type="BoxMesh" id="Mesh_south"]
material = SubResource("Mat_south")
size = Vector3(3, 0.2, 1.44)

; An AnimatableBody3D for the same reason MovingPlatform is one: it can tell
; whatever is standing on it how fast its surface is moving, which is what
; actually carries a rider.
[node name="SeeSaw" type="AnimatableBody3D"]
collision_layer = 1
; Explicitly FALSE, and it must be written out: AnimatableBody3D defaults it to
; true, and its own documentation says "do not use together with
; _physics_process()" — which is exactly how this plank is driven. With sync on,
; the collision shape lags behind the node, so the plank draws at one angle and
; collides at another and the player falls through the surface they are standing
; on. see_saw.gd sets `constant_angular_velocity` instead.
sync_to_physics = false
script = ExtResource("1")

[node name="Shape" type="CollisionShape3D" parent="."]
shape = SubResource("Shape_plank")

[node name="Visual" type="Node3D" parent="."]

[node name="Plank" type="MeshInstance3D" parent="Visual"]
mesh = SubResource("Mesh_plank")

; The two ends, in colours far apart in hue. A tilting plank with identical ends
; reads as a glitch rather than as a mechanism. Positioned by _apply_size().
[node name="PadNorth" type="MeshInstance3D" parent="Visual"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.2, 3.78)
mesh = SubResource("Mesh_north")

[node name="PadSouth" type="MeshInstance3D" parent="Visual"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.2, -3.78)
mesh = SubResource("Mesh_south")

; Sized and positioned by _apply_size(); the values here are what a 3 x 0.4 x 9
; plank works out to, so the scene is correct on its own in the editor.
[node name="Weight" type="Node" parent="."]
script = ExtResource("2")
size = Vector3(3, 2.4, 9)
offset = Vector3(0, 1.4, 0)
