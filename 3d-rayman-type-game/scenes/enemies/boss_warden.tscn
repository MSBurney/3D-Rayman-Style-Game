[ext_resource type="Script" uid="uid://cdeeoi8dqqb1j" path="res://scripts/components/item_thief.gd" id="snatcher"]

[sub_resource type="BoxShape3D" id="Shape_body"]
size = Vector3(3, 3, 3)

[sub_resource type="BoxShape3D" id="Shape_hurt"]
size = Vector3(3.6, 3.2, 3.6)

[sub_resource type="StandardMaterial3D" id="Mat_shell"]
; `emission_enabled` here rather than in code: it is a shader feature flag, and
; the script tints a DUPLICATE of this material. See priced_gate.tscn.
albedo_color = Color(0.46, 0.5, 0.58, 1)
emission_enabled = true
emission = Color(0.46, 0.5, 0.58, 1)
emission_energy_multiplier = 0.45
metallic = 0.5
roughness = 0.4

[sub_resource type="BoxMesh" id="Mesh_shell"]
material = SubResource("Mat_shell")
size = Vector3(3, 3, 3)

[sub_resource type="StandardMaterial3D" id="Mat_eye"]
albedo_color = Color(0.1, 0.1, 0.12, 1)

[sub_resource type="BoxMesh" id="Mesh_eye"]
material = SubResource("Mat_eye")
size = Vector3(2.2, 0.5, 0.2)

; Note NO Health node, and that is the design rather than an omission: this boss
; cannot be killed. You beat it by taking the seed and delivering it, so the
; hostage system is its health bar. See boss_warden.gd.
;
; Collision properties are on their own lines, because inside the [node ...]
; header they are silently ignored.
[node name="BossWarden" type="CharacterBody3D"]
collision_layer = 4
collision_mask = 1
floor_max_angle = 0.9
script = ExtResource("1")

[node name="Shape" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
shape = SubResource("Shape_body")

[node name="Visual" type="Node3D" parent="."]

[node name="Shell" type="MeshInstance3D" parent="Visual"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
mesh = SubResource("Mesh_shell")

[node name="Eye" type="MeshInstance3D" parent="Visual"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.1, -1.55)
mesh = SubResource("Mesh_eye")

[node name="Hurtbox" type="Area3D" parent="."]
collision_layer = 0
collision_mask = 2

[node name="Shape" type="CollisionShape3D" parent="Hurtbox"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
shape = SubResource("Shape_hurt")

[node name="Snatcher" type="Node" parent="."]
script = ExtResource("snatcher")
grab_distance = 2.6
; Longer than the default: cracking the boss open drops the seed at its own
; feet, and the player needs a real head start to reach it first.
relatch_delay = 2.5

[node name="Sfx" type="AudioStreamPlayer3D" parent="."]
