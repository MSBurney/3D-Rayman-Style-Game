[gd_scene format=3 uid="uid://cmxrmaonlm2u7"]

; The project's entry scene. `run/main_scene` in project.godot points here.
;
; It used to be the OLD suite's fixture as well — `moveset_smoke_test.gd`
; instantiated this file, which quietly meant the entry scene could not change
; without taking 214 checks with it. That snapshot now lives in
; `scenes/legacy_main.tscn`, and the two are free of each other.

[ext_resource type="Script" uid="uid://dlctxiqwl8dhd" path="res://scripts/game.gd" id="1"]
