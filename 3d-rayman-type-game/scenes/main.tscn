[node name="HeavyYard" parent="." instance=ExtResource("2")]

; Only `transform` is ever overridden on a repointed Player, so there is one
; place to read a default from and a scene cannot quietly shadow the script.
[node name="Player" parent="." instance=ExtResource("3")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 14)

