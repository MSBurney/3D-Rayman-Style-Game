; ───────────────────────────────────────────────── problem 1: the ramp and the wall
;
; **The transform and the size are copied VERBATIM from the greybox's ramp**,
; with only x changed. That is deliberate engineering cowardice: a hand-written
; rotation has come out wrong every single time this project has authored one,
; and this exact basis is the one `tests/greybox_probe.gd` has already measured
; against tan(15 degrees). Re-deriving it would be re-rolling a dice this
; project has lost four times.
;
; Godot serialises a Transform3D basis ROW by row, so those nine numbers are
; rows and not the x/y/z axis columns. Read them as columns and you get a ramp
; tilted the wrong way, which is invisible until you probe the surface normals.
;
; The top surface passes through y = 4 at z = -15 and rises toward -z, so it
; meets the ground at z = 0 and reaches y = 8 at z = -30.
[node name="Ramp" type="CSGBox3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.9659, -0.2588, 0, 0.2588, 0.9659, -20, 3.276, -15.194)
use_collision = true
size = Vector3(14, 1.5, 31)
material = SubResource("MatRamp")

[node name="RampDeck" type="CSGBox3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -20, 7.25, -36)
use_collision = true
size = Vector3(14, 1.5, 12)
material = SubResource("MatRamp")

; break_speed 22 is the whole of this problem: a charge on the flat reaches 20
; and is SHORT, a charge down the ramp reaches 26 and goes through. If this ever
; becomes breakable without the ramp, the setup has stopped asking its question.
;
; `strike_momentum` -1 turns the slam route off, so the wall cannot be opened
; from above either. Speed is the only answer.
[node name="RampWall" parent="." instance=ExtResource("wall")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -20, 1, 4.5)
break_speed = 22.0
strike_momentum = -1.0
coin_count = 0

