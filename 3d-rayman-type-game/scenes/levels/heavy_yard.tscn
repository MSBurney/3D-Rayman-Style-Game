worth = 70

; 250 against 310 on the floor, so about four fifths of everything. The point of
; pricing it tight is that the NEXT coin is worth something; price it low and
; nothing you collect after the threshold matters at all.
[node name="Exit" parent="." instance=ExtResource("exit")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 20)
price = 250

; ────────────────────────────────────────────────────── the walls of the world
;
; Not decoration. With no death, walking off the edge is an infinite fall, and
; the doc bans ejection outright — so the yard is closed and every hole has a
; staircase. The only penalty anywhere here is the climb back.

