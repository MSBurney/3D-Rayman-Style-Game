[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMat")

; Sky ambient at full energy on top of a 1.0 sun washes every albedo out to
; pastel. 0.3 keeps the fill light without blowing out the blockout colours.
[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 3
ambient_light_energy = 0.3
tonemap_mode = 2

[sub_resource type="StandardMaterial3D" id="MatGrass"]
albedo_color = Color(0.42, 0.62, 0.35, 1)

[sub_resource type="StandardMaterial3D" id="MatStone"]
