[node name="TestLevel" type="Node3D"]

[node name="Environment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

; Bias is raised from the defaults because the level spans ~200 m, which stretches
; the shadow cascades thin enough to speckle flat ground with acne.
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.353553, 0.353553, 0, 0.707107, 0.707107, -0.5, -0.612372, 0.612372, 0, 40, 0)
light_energy = 1.0
shadow_enabled = true
shadow_bias = 0.2
shadow_normal_bias = 3.0
directional_shadow_max_distance = 140.0

; ---------------------------------------------------------------- HUB
; Spawn plaza. Everything radiates from here so any mechanic is a short walk away.

[node name="Hub" type="CSGBox3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
use_collision = true
size = Vector3(30, 1, 30)
material = SubResource("MatGrass")

; Both sit outside their own 11 m detect range of the spawn point, so you get a
; moment to find the controls before anything walks at you.
[node name="HubWalkerA" parent="." instance=ExtResource("walker")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -8, 0.1, -6)
patrol_distance = 5.0

