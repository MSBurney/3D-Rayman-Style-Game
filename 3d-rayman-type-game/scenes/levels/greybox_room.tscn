; ───────────────────────── universal weight rule 3: the heavier side wins ────
;
; A plank with a crate on one end. Step onto the far end near the middle and
; nothing happens, because the crate out-levers you. Walk right out to the end
; and it tips — a lever multiplies by DISTANCE, not just by mass, and finding
; that out unaided is the best thing this prop does. Then slam that end and the
; crate is thrown off the other one.
[node name="SeeSaw" parent="." unique_id=771200411 instance=ExtResource("seesaw")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -24, 1.4, 6)

; Decorative, and `use_collision` is deliberately absent. A solid fulcrum under
; a kinematically-driven plank is just something for the physics to argue with.
[node name="SeeSawFulcrum" type="CSGBox3D" parent="." unique_id=1055370238]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -24, 0.6, 6)
size = Vector3(1.2, 1.2, 1.2)
material = SubResource("MatTower")

; A RigidBody3D with a mass and NO SCRIPT AT ALL — which is the whole point of
; the `heavy` group. `mass` is a property RigidBody3D already has, so the weight
; layer reads a bare crate for free. Deliberately LIGHTER than the player (8
; against 10), so that leverage and not mass is what decides this see-saw.
[node name="SeeSawCrate" type="RigidBody3D" parent="." groups=["carryable", "heavy"] unique_id=1719944525]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -24, 2.2, 9.6)
; Layer 64 is "loose heavy object" — the same layer the throwable keg uses. The
; player masks it, so ramming works through slide collisions, and the player's
; Hitbox masks ONLY this layer, so a crate arriving under its own steam is
; noticed while level geometry never reaches the area at all.
collision_layer = 64
collision_mask = 67
mass = 8.0

[node name="Shape" type="CollisionShape3D" parent="SeeSawCrate"]
shape = SubResource("Shape_crate")

[node name="Mesh" type="MeshInstance3D" parent="SeeSawCrate"]
mesh = SubResource("Mesh_crate")

; Break speed 12, which the hero cannot reach on the flat (the charge tops out
; at 20 but this sits in open ground with no run-up) and a thrown crate clears
; easily at 17. **Rule 5 made visible:** before the weight layer existed, a
; crate hurled at a wall did nothing whatsoever, because the block asked for a
; method only a CharacterBody3D has.
[node name="ThrowWall" parent="." unique_id=1288004712 instance=ExtResource("wall")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -24, 1, -9)
break_speed = 12.0
require_spin_step = -1
require_slam_power = -1.0

; ──────────────────── universal weight rule 1: a visible weight threshold ────
;
; Walk on and stand still and it latches, raising the lift. A charge crosses a
; 1.8 m pad in about five physics frames against a fifteen-frame hold, so it
; cannot be set off on the way past — which is what "walk-mode precision" means
; here in practice rather than in principle.
[node name="Plate" parent="." unique_id=288337109 instance=ExtResource("plate")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22, 0, 18)
; MORE THAN THE PLAYER WEIGHS (10), on purpose. This is the interesting kind of
; plate — "this needs more than you, go and find something" — and it is only
; solvable at all now that weight rule 2 exists: you ram PlateCrate onto it.
required_mass = 14.0
stays_pressed = true
activates = NodePath("../PlateLift")

; The answer to the plate, parked a push away to the WEST of it rather than in
; front of it. Heavy enough to hold the plate on its own (16 against 14), so the
; crate stays put and you walk off and ride the lift.
;
; Not in the plate's north-south lane on purpose: a 16-mass crate parked in
; front of a 10-mass hero is a roadblock that crash-stuns every charge down that
; line, and the lane is also how you prove a charge cannot trip the plate.
[node name="PlateCrate" type="RigidBody3D" parent="." groups=["carryable", "heavy"] unique_id=1066320415]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 16, 0.8, 18)
collision_layer = 64
collision_mask = 67
mass = 16.0

[node name="Shape" type="CollisionShape3D" parent="PlateCrate"]
shape = SubResource("Shape_crate")

[node name="Mesh" type="MeshInstance3D" parent="PlateCrate"]
mesh = SubResource("Mesh_crate")

[node name="PlateLift" parent="." unique_id=1942117925 instance=ExtResource("lift")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22, 0.3, 30)

; Where the lift goes. Its top is 12.0, which matches the lift's travel exactly
; rather than nearly — tests/greybox_probe.gd measures the pair against each
; other, because "nearly" is a step the player trips on.
[node name="PlateDeck" type="CSGBox3D" parent="." unique_id=480862326]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22, 11.6, 40)
use_collision = true
size = Vector3(10, 0.8, 10)
material = SubResource("MatDeck")

; ─────────────────── universal weight rule 5: it obeys the same physics ─────
;
; A mobile mass, and FOUR puzzle uses with no code written for any of them:
;
;   - lure it onto the Plate and its 40 holds the 14 down, so the crate is no
;     longer the only answer. Two solutions is the doc working as intended:
;     "rooms are stated as problems, not locks"
;   - lure it over FragileSlab and the floor gives way under it and not under
;     you, because `break_mass` sits between 40 and your 10
;   - lure it into MassWall, which nothing you can do will open
;   - charge it and it goes down, and a felled giant is a low wide platform
[node name="Giant" parent="." unique_id=1443208853 instance=ExtResource("giant")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 34, 0, 20)

; Flush with the floor, top at y=0, so it is a surface and never a kerb — a
; 30 cm lip would stop a charge dead and snag the giant's own walk cycle.
;
; Only MASS opens it: the fall speed and slam thresholds are set out of reach so
; the demonstration is about weight alone and nothing else.
[node name="FragileSlab" parent="." unique_id=1960409072 instance=ExtResource("crumb2")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 28, -0.3, 20)
size = Vector3(4, 0.6, 4)
break_mass = 20.0
break_fall_speed = 999.0
slam_power_needed = 99.0
reset_delay = 5.0

; A wall the hero CANNOT open, at any speed, ever: `break_speed` is out of
; reach and only `break_mass` applies. The giant walks through it at 3 m/s.
[node name="MassWall" parent="." unique_id=896130722 instance=ExtResource("wall")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 34, 1, 29)
break_speed = 999.0
break_mass = 30.0
require_spin_step = -1
require_slam_power = -1.0

; Visible from the ground, so the plate reads as a question that has an answer
; somewhere rather than as a button with no consequence.
[node name="PlateMarker" type="CSGBox3D" parent="." unique_id=1377486290]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22, 13.6, 40)
size = Vector3(0.6, 3.2, 0.6)
material = SubResource("MatMarker")
